# Copia este archivo como ".env" y ajusta los valores. NO subas ".env" a Git.
# Usa contraseñas sin caracteres especiales (@ : / #) para evitar problemas en DATABASE_URL.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=recursos_db

# Puerto de PostgreSQL en TU máquina (cámbialo si ya tienes un Postgres local en el 5432)
DB_PORT=5432

# Secreto para firmar los tokens de sesión (login con roles, US01)
JWT_SECRET=cambia_este_secreto

# Solo producción: puerto público de la app
APP_PORT=80
